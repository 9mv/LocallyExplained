ADMIN_EMAIL=admin@locally-explained.local
ADMIN_PASSWORD=admin123

# Resend configuration
RESEND_API_KEY=re_123
# Optional in local dev; use a verified sender/domain in production
RESEND_FROM_EMAIL=LocallyExplained <onboarding@resend.dev>

# Neon / Postgres database
# DATABASE_URL is the only required database variable for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
PGHOST=HOST
PGHOST_UNPOOLED=HOST
PGUSER=USER
PGDATABASE=DB
PGPASSWORD=PASSWORD
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
POSTGRES_USER=USER
POSTGRES_HOST=HOST
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DATABASE=DB
POSTGRES_URL_NO_SSL=postgresql://USER:PASSWORD@HOST/DB
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
